# 复制为 backend/.env 并按环境修改。.env 不入库。
# 数据库连接（本地开发容器见 docker-compose.yml）
DATABASE_URL=postgresql+psycopg://ae_knowledge:ae_knowledge_dev@localhost:5432/ae_knowledge

# 运行环境：development / production（production 下禁用开发辅助端点）
ENVIRONMENT=development

# 运行日志
# 日志级别：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
# true=输出 JSON 结构化日志；空则按环境推导（production=JSON，development=人类可读）
# LOG_JSON=true
# 是否把 ERROR+ 日志 best-effort 持久化到 platform.log_events
# LOG_PERSIST_ERRORS=true

# 测试数据库连接（pytest 使用独立库，避免污染开发数据）
TEST_DATABASE_URL=postgresql+psycopg://ae_knowledge:ae_knowledge_dev@localhost:5432/ae_knowledge_test

# 飞书接入：fake=开发/测试；real=接入真实飞书（需配置下面凭据）
FEISHU_PROVIDER=fake
# 飞书应用凭据（开发者后台「凭证与基础信息」；secret 属于机密，仅写 .env/部署环境变量）
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_app_secret
FEISHU_BASE_URL=https://open.feishu.cn
# 扫码登录授权 host（官方示例默认值）
FEISHU_PASSPORT_HOST=https://passport.feishu.cn/suite/passport/oauth/
# 后端 OAuth 回调地址，需在飞书后台「安全设置 → 重定向 URL」登记一致
FEISHU_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/feishu/callback
# 绑定成功后浏览器跳转的前端地址
FEISHU_FRONTEND_REDIRECT_URI=http://127.0.0.1:5173

# 凭据信封加密密钥（base64 编码 32 字节；生产必须用密钥管理/部署变量覆盖，示例值仅限本地开发）
TOKEN_ENC_KEY=ZGV2LW9ubHktdG9rZW4tZW5jLWtleS0zMi1ieXRlcyE=

# 登录会话
SESSION_COOKIE_NAME=ae_session
SESSION_TTL_HOURS=24

# ---- LangGraph 知识助手 Agent（DD-21，默认关闭） ----
# 灰度/验收通过后置为 true；回滚置回 false 即可切回旧编排
AGENT_GRAPH_ENABLED=false
AGENT_GRAPH_VERSION=knowledge-assistant-v1
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=90
AGENT_INTENT_REPAIR_LIMIT=1
AGENT_QUERY_REWRITE_LIMIT=1
AGENT_CITATION_REPAIR_LIMIT=1
CONVERSATION_RECENT_TOKEN_BUDGET=6000
CONVERSATION_SUMMARY_TOKEN_BUDGET=1500
CONVERSATION_COMPACTION_TRIGGER_RATIO=0.70
# 与业务库分离的 checkpoint 连接串；留空复用 DATABASE_URL（独立 agent_runtime schema）
# AGENT_CHECKPOINT_DSN=postgresql+psycopg://user:pass@host:5432/db
AGENT_CHECKPOINT_RETENTION_DAYS=14
# 受控脱敏采样（安全要求，默认关闭）：开启后 agent 日志含截断的提问/答案预览，
# 便于排查；仍不记录完整问题、证据正文、提示词与密钥
# AGENT_LOG_PAYLOADS=true
