# 复制为 backend/.env 并按环境修改。.env 不入库。
# 数据库连接（本地开发容器见 docker-compose.yml）
DATABASE_URL=postgresql+psycopg://ae_knowledge:ae_knowledge_dev@localhost:5432/ae_knowledge

# 运行环境：development / production（production 下禁用开发辅助端点）
ENVIRONMENT=development

# 测试数据库连接（pytest 使用独立库，避免污染开发数据）
TEST_DATABASE_URL=postgresql+psycopg://ae_knowledge:ae_knowledge_dev@localhost:5432/ae_knowledge_test
