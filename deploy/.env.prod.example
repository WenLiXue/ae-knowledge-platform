# 复制到项目根目录 .env 后修改，生产密钥不要提交到 Git。
POSTGRES_USER=ae_knowledge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ae_knowledge

# 必须是 base64 编码的 32 字节密钥；生产环境请使用密钥管理系统注入。
TOKEN_ENC_KEY=replace-with-base64-32-byte-key
AUDIT_HMAC_KEY=replace-with-audit-hmac-key

# 浏览器对外访问地址；如部署在域名下请包含协议和端口（如有）。
FEISHU_REDIRECT_URI=http://localhost/api/v1/auth/feishu/callback
FEISHU_FRONTEND_REDIRECT_URI=http://localhost

# 当前示例通过 HTTP 访问；配置 HTTPS 后改为 true。
SESSION_COOKIE_SECURE=false

# 默认使用 PostgreSQL 内置 pgvector。
SEARCH_ENGINE=pgvector
SEARCH_INDEX_NAME=knowledge_chunks

# 接入飞书时改为 real 并补齐凭据。
FEISHU_PROVIDER=real
FEISHU_APP_ID=
FEISHU_APP_SECRET=
HTTP_PORT=80

# 工具型 Agent 灰度开关：验收通过前保持关闭。
AGENT_TOOLS_ENABLED=false
AGENT_PLANNER_ENABLED=false
AGENT_WRITE_TOOLS_ENABLED=false
AGENT_MAX_PLAN_STEPS=8
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_REPLANS=2
AGENT_TASK_TIMEOUT_SECONDS=180
